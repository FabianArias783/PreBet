{
  "functions": {
    "api/matches.js": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/api/matches", "destination": "/api/matches.js" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "s-maxage=1800, stale-while-revalidate" }
      ]
    }
  ]
}
